{
  "name": "Marimo Xpress Notebooks",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r marimo/requirements.txt",
  "postStartCommand": "marimo run --host 0.0.0.0 --port 2718 --no-token --include-code marimo/",
  "forwardPorts": [2718],
  "portsAttributes": {
    "2718": {
      "label": "marimo",
      "onAutoForward": "notify"
    }
  }
}