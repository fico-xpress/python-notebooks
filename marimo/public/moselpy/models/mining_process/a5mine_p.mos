*******************************************************!)

model "A-5 Opencast mining"
 uses "mmxprs"

 parameters
  DATASOURCE = "../../data/mining_process/a5mine_p.dat"
  OUTFILE    = ""
  NB         = 18                      ! Number of blocks
  NLO        = 9                       ! First block in levels 2 and 3
  NHI        = 18                      ! Last block in levels 2 and 3
 end-parameters

 declarations
  BLOCKS  = 1..NB
  LEVEL23 = NLO..NHI                         ! Blocks in levels 2 and 3
  COST: array(BLOCKS) of real                ! Exploitation cost of blocks
  VALUE: array(BLOCKS) of real               ! Value of blocks
  ARC: array(LEVEL23,1..3) of integer        ! Arcs indicating order of extraction
  WEIGHT: integer                      ! Scaling weight for objective

  extract: array(BLOCKS) of mpvar      ! 1 if block b is extracted

  sol_extract: array(BLOCKS) of real
 end-declarations

 initializations from DATASOURCE
  COST VALUE ARC WEIGHT
 end-initializations

 Profit:= sum(b in BLOCKS) (VALUE(b)-COST(b))*extract(b)

 forall(b in LEVEL23)
  forall(i in 1..3) extract(b) <= extract(ARC(b,i))

 forall(b in BLOCKS) extract(b) is_binary

 maximize(Profit)

 forall(b in BLOCKS) sol_extract(b) := getsol(extract(b))

 initializations to OUTFILE
  evaluation of getobjval*WEIGHT as 'obj_val'
  sol_extract
 end-initializations

end-model
